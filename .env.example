# Environment variables. Names only — this file never carries a value.
# Copy to .env for local work. .env is git-ignored; this file is not.
#
# =============================================================================
# NO SECRET MAY TAKE A PUBLIC_ PREFIX.
#
# SvelteKit inlines every PUBLIC_-prefixed variable into the client bundle at
# build time. Anything behind that prefix is published to every browser that
# loads the app, permanently, and cannot be un-published by rotating the
# deployment. The two blocks below are separated for that reason and must stay
# separated. A secret that appears in the second block is a breach, not a typo.
# =============================================================================


# -----------------------------------------------------------------------------
# Server-only. Never prefixed PUBLIC_. Never imported into a .svelte file.
# Read through $env/static/private or $env/dynamic/private only.
# -----------------------------------------------------------------------------

# Supabase — the project for this deploy context. production -> prod, every
# other context -> dev. The mapping is committed in netlify.toml.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Discord OAuth2 application — identity (AD-15). Discord is the only identity
# provider; there is no self-service registration and no email field anywhere.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Discord incoming webhook — notifications (AD-18). Write-only, 30 req/min.
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=

# The Commissioner sign-in that does not depend on Discord. Unadvertised but
# reachable, because Discord carries both authentication and notification and a
# Discord outage must not lock the referee out of the pause control.
COMMISSIONER_RECOVERY_SECRET=

# Shared secret the Supabase Cron tick presents when invoking the Edge Function.
TICK_INVOCATION_SECRET=

# Which Supabase project this deploy points at: "prod" or "dev". Set per context
# in netlify.toml; asserted by scripts/check-pins.js.
SUPABASE_ENVIRONMENT=
APP_ENV=


# -----------------------------------------------------------------------------
# Client-inlined. PUBLIC_ prefix. Assume every value here is world-readable.
# Nothing that grants a write may appear below this line.
# -----------------------------------------------------------------------------

# The browser's Supabase connection, used only for read-only Realtime
# subscriptions. The anon role holds no write privilege on any table and every
# table carries an explicit row-level policy.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
