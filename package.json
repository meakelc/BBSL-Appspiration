{
  "name": "bbsl-auction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appspiration — the BBSL offseason free agent auction.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-pins.js && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:pins": "node scripts/check-pins.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "6.0.4",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
