{
  "name": "bbsl-auction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appspiration — the BBSL offseason free agent auction.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-pins.js && node scripts/check-core-purity.js && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:pins": "node scripts/check-pins.js",
    "check:purity": "node scripts/check-core-purity.js",
    "verify:supabase": "node scripts/verify-supabase.js",
    "seed:league": "node scripts/seed-league.js",
    "reset:pilot": "node scripts/reset-pilot.js",
    "name:rosters": "node scripts/name-roster-exports.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "csv-parse": "7.0.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "6.0.4",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
